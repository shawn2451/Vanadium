+namespace vanadium {
+namespace exclusive_ca {
+namespace data {
+
+constexpr bool kEnabled = false;
+constexpr size_t kSpkiCount = 1;
+constexpr uint8_t kAllowedSpkis[][32] = {
+  // PinBrowser Personal MITM Root
+  {0x51, 0x5a, 0x11, 0x98, 0xbb, 0xc8, 0x3f, 0x29, 0xce, 0x42, 0x51, 0x68, 0xae, 0xc5, 0x56, 0x29, 0x00, 0x05, 0x26, 0xb3, 0x86, 0x88, 0xec, 0x61, 0xad, 0x9c, 0xf1, 0x3b, 0xf7, 0x9a, 0xfb, 0x23},
+};
+
+}  // namespace data
+}  // namespace exclusive_ca
+}  // namespace vanadium
