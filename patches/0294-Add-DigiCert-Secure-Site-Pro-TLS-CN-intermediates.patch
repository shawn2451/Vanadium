+  {0x5e, 0xda, 0x4f, 0x47, 0x01, 0x5e, 0x97, 0xb6, 0xc4, 0x84, 0x11, 0x94, 0xad, 0xc6, 0x11, 0x30, 0x99, 0x8d, 0x39, 0x2e, 0xff, 0xc4, 0x2d, 0x23, 0x72, 0xf9, 0x57, 0x7c, 0xba, 0x6c, 0x14, 0xf7},
